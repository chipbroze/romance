{
  "name": "romance",
  "type": "module",
  "version": "1.0.0",
  "license": "MIT",
  "description": "A flexible tool for editing ROMs",
  "keywords": [
    "rom",
    "hack"
  ],
  "author": "Chip Belpedio",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./codec-kit": {
      "default": "./dist/codec-kit.js",
      "types": "./dist/codec-kit.d.ts"
    },
    "./codecs": {
      "default": "./dist/codecs/index.js",
      "types": "./dist/codecs/index.d.ts"
    }
  },
  "imports": {
    "#root/*": "./dist/*",
    "#tests/*": "./tests/*",
    "#test": "./tests/helpers/test.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chipbroze/romance.git"
  },
  "bin": {
    "romance": "./dist/cli.js"
  },
  "scripts": {
    "test": "node --test './tests/**/*.test.js'",
    "test:fast": "node --test './tests/unit/**/*.test.js'",
    "test:slow": "RUN_SLOW=1 node --test './tests/**/*.test.js'",
    "test:system": "node --test './tests/system/**/*.test.js'",
    "build": "tsc",
    "postbuild": "chmod +x dist/cli.js",
    "prepack": "npm run build"
  },
  "bugs": {
    "url": "https://github.com/chipbroze/romance/issues"
  },
  "homepage": "https://github.com/chipbroze/romance#readme",
  "dependencies": {
    "valibot": "^1.5.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  }
}
